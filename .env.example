# Copy to .env.local (git-ignored) and fill in. Also set these in your host's
# project settings for production.

# Brevo transactional email API key — Brevo dashboard > SMTP & API > API keys.
BREVO_API_KEY=

# Where contact enquiries are delivered.
CONTACT_TO_EMAIL=info@kaevor-ai.tech

# The From address enquirers see. Deliberately an unattended address so no real mailbox
# is exposed to everyone who uses the form — replies still reach us because both emails
# set reply-to (the enquirer on the notification, CONTACT_TO_EMAIL on the auto-reply).
# kaevor-ai.tech is domain-authenticated in Brevo, so any address here works without
# registering it as an individual sender.
CONTACT_FROM_EMAIL=noreply@kaevor-ai.tech

# Absolute base URL used for the logo and links inside emails — email clients cannot
# resolve relative paths. Defaults to https://kaevor-ai.tech; override for staging.
SITE_URL=https://kaevor-ai.tech
